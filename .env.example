# Copy to .env and adjust. All values here are safe defaults for local development.
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# SQLite by default; docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///db.sqlite3
# DATABASE_URL=postgres://ecommerce:ecommerce@db:5432/ecommerce

# Commerce settings
VAT_RATE=0.05
RESERVATION_TTL_MINUTES=30
DEFAULT_CURRENCY=BDT

# Payment provider secrets (sandbox stubs; never commit real values)
BKASH_WEBHOOK_SECRET=bkash-sandbox-secret
SSLCOMMERZ_WEBHOOK_SECRET=sslcommerz-sandbox-secret

# JWT lifetimes
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
